# ctx-weft Configuration Example
# Copy to .env and fill in values. System environment variables take precedence.
#
# 约定：注释掉的行展示的是代码内置默认值，取消注释即可覆盖。激活的行（无 #）是
# 出厂生效值。所有 NLC_* 由 host config.py 读取一次。

# ── LLM 默认账号 ──────────────────────────────────────────────────────────────
# 默认账号不再用 NLC_LLM_* 环境变量，改由扁平 JSON 种子提供（可多账号、多 provider，
# 字段同原 NLC_LLM_*：account/style/api_key(enc:v1:)/base_url/model/context_limit/…）：
#   出厂/随包默认账号 → default_llm_accounts.json（与本文件同随包）
# 本地开发覆盖：设下面这行指向一个本地 gitignored 文件（放真实 key、不入库），不设则用随包出厂账号。
# NLC_LLM_ACCOUNTS_FILE=data/llm_accounts.dev.json

# ── LLM resilience / self-heal ────────────────────────────────────────────────
# LLM 调用的重试与中断自愈预算（详见 docs：LLM outage self-heal）。
# 单次 LLM HTTP 调用的最大重试次数。Default: 3
# NLC_LLM_MAX_HTTP_RETRIES=3
# outage 自愈：最大重试轮数 / 总时长上限(秒) / 退避起始与封顶间隔(秒)。
# NLC_LLM_SELF_HEAL_MAX_ATTEMPTS=8
# NLC_LLM_SELF_HEAL_MAX_DURATION_SEC=300
# NLC_LLM_SELF_HEAL_BASE_DELAY_SEC=2
# NLC_LLM_SELF_HEAL_MAX_INTERVAL_SEC=60

# ── Persistence ───────────────────────────────────────────────────────────────
# Memory provider backend. Omit for in-memory (stateless, default).
#
# SQLite (local dev — file created at project root):
# DATABASE_URL=sqlite
# SQLite with explicit path:
# DATABASE_URL=sqlite:///./data/ipmc.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/CtxWeft
DATABASE_URL=sqlite

# 快照（用于会话恢复）：每累计 N 个事件写一次快照 / 每会话保留最新张数。
# NLC_SNAPSHOT_EVERY_N_EVENTS=50
# NLC_SNAPSHOT_KEEP=3

# rewind（工作区文件检查点 / 回滚，存于 <数据目录>/checkpoints/<会话>/，blob 内容寻址+zlib 压缩）。
# 开关：关掉则不拍快照、对话里也不显示回退按钮。
NLC_REWIND_ENABLED=true
# 每会话保留的检查点数；超出后 gc 丢最旧的 + 清理不再被引用的 blob。
NLC_REWIND_KEEP=15
# 单文件超过多少 MB 就跳过（不纳入快照/回滚）——大二进制想被覆盖就调大。
NLC_REWIND_MAX_FILE_MB=100

# ── Resources ────────────────────────────────────────────────────────────────
# Root directory for all user-authored and runtime config files.
# Defaults to <project_root>/resources/ when not set.
#
# Default layout under NLC_RESOURCES_DIR:
#   agents/           agent template directories      (NLC_AGENTS_DIR default)
#   skills/           local skill directories         (NLC_SKILLS_DIR default)
#   templates/        template metadata JSON          (TemplateStore)
#   llm_configs/      LLM account configs JSON        (LLMAccountStore)
#   skill_sources/    remote skill source configs     (RemoteSkillSourceStore)
#   skill_caches/     git-synced remote skill files   (RemoteSkillCapabilityProvider)
#   mcp.json          MCP server configs              (MCPServerStore)
NLC_RESOURCES_DIR=

# Override individual subdirs (optional — defaults to subdirs of NLC_RESOURCES_DIR):
NLC_AGENTS_DIR=
NLC_SKILLS_DIR=

# 启动时若无显式模板选择，使用的默认 agent 模板 id。Default: default
# NLC_DEFAULT_TEMPLATE_ID=default

# ── Data ──────────────────────────────────────────────────────────────────────
# Directory for persistent database files only (SQLite / Postgres data).
# Defaults to <project_root>/data/ when not set.
# SQLite file: <NLC_DATA_DIR>/ipmc-dev.db (or set DATABASE_URL explicitly).
NLC_DATA_DIR=

# ── Python venv (bash 脚本 + skill 脚本共用一套) ──────────────────────────────
# 打包态：_run.py 用随包 python-runtime 建一套【全应用共享 venv】于 <NLC_DATA_DIR>/venv，
# 并头插进进程 PATH（VIRTUAL_ENV/删 PYTHONHOME）→ agent 的 bash 命令与 skill 脚本的所有
# python/pip 都命中它，绝不落到用户本地 python，也不再每个 workspace 各建一个 .venv。
# 缺随包 python-runtime 会硬退出（打包只允许随包 python）。
# dev/源码态：下面留空 → 沿用旧的"每 workspace 自动建 .venv"（用宿主 sys.executable 创建），
# 行为不变、不受影响。
#
# 创建 venv 用的解释器。留空=宿主 sys.executable（dev 正确）；打包态由 _run.py 自动指向
# 随包 runtime（exe_dir/python-runtime/python.exe）。仅需强制指定某个 Python 时才手动设。
# NLC_FS_BASH_VENV_PYTHON=
# 共享 venv 的位置（仅打包态；默认 <NLC_DATA_DIR>/venv）。一般不用改。
# NLC_SHARED_VENV_DIR=

# Internal PyPI mirror for `pip install` (used by both bash_exec and skill scripts,
# which run pip in the workspace venv). Mapped to the standard PIP_* env vars at
# startup, so all subprocesses inherit them. For an http (non-https) mirror, also set
# the trusted host to avoid pip's TLS error.
NLC_PIP_INDEX_URL=https://mirrors.tools.huawei.com/pypi/simple
# NLC_PIP_EXTRA_INDEX_URL=
NLC_PIP_TRUSTED_HOST=mirrors.tools.huawei.com
# pip 网络超时(秒)，映射为标准 PIP_TIMEOUT。
NLC_PIP_TIMEOUT=120

# bash_exec 执行限额：整体超时 / 无输出空闲超时 / 硬上限(秒) / 最大输出字节。
# NLC_FS_BASH_TIMEOUT_SEC=30
# NLC_FS_BASH_IDLE_TIMEOUT_SEC=30
# NLC_FS_BASH_HARD_CAP_SEC=120
# NLC_FS_BASH_MAX_OUTPUT_BYTES=50000

# 文件读取工具限额：默认行数 / 单次最大字节 / 单行最大字节 / 计数模式最大字节。
# NLC_FS_FILE_READ_DEFAULT_LINES=2000
# NLC_FS_FILE_READ_MAX_BYTES=262144
# NLC_FS_FILE_READ_MAX_LINE_BYTES=4096
# NLC_FS_FILE_READ_COUNT_MAX_BYTES=5242880

# glob 工具单次返回的最大匹配数。
# NLC_FS_GLOB_MAX_RESULTS=500

# ── HTTP fetch tool ───────────────────────────────────────────────────────────
# 内置 HTTP 抓取工具：请求超时(秒) / 响应体最大字节 / 是否校验 TLS 证书。
# 默认 SSL 校验关闭（适配内网自签场景）；公网部署建议开启。
# NLC_HTTP_TIMEOUT_SEC=30
# NLC_HTTP_MAX_RESPONSE_BYTES=1000000
NLC_HTTP_SSL_VERIFY=false

# ── MCP ───────────────────────────────────────────────────────────────────────
# MCP server 断线重连：最大尝试次数 / 退避起始间隔(秒)。
# NLC_MCP_MAX_RECONNECT_ATTEMPTS=3
# NLC_MCP_RECONNECT_BASE_DELAY_SEC=1
# 注：http transport 是否信任环境代理/证书（trust_env）是每台 MCP server 的持久化配置，
# 写在 mcp.json 的 server 条目里（默认 false），不走全局环境变量。

# ── Skill execution ───────────────────────────────────────────────────────────
# skill 脚本执行限额：空闲超时(无输出多久算卡死) / 硬上限(墙钟总时长封顶，秒) / 输出字符上限。
# NLC_SKILL_IDLE_TIMEOUT_SEC=90
NLC_SKILL_HARD_CAP_SEC=3600
# 云端 skill 下载（引用式加载）重试：错误重试次数上限 + 指数退避起始间隔(秒)。
# 总尝试 = retries+1。
# NLC_SKILL_DOWNLOAD_RETRIES=2
# NLC_SKILL_DOWNLOAD_RETRY_DELAY_SEC=1.0
# NLC_SKILL_OUTPUT_LIMIT_CHARS=65536
# 远程 skill 拉取服务地址（skill_sources 同步）。
NLC_SKILL_PULL_SERVER_URL=https://ipmastercowork.gts.huawei.com/api
# IP Master Mythos 服务地址（厂商内置，每次安装/升级强制对齐当前构建值）。
# 留空 = 不接入 mythos 这一家。配了它，通用页签里就会混进它的 skill。
# 必须写成显式空值而不是注释掉：升级时按 env-reconcile 强制对齐随包模板，
# 注释掉的话老用户 .env 里那行旧地址会原样留着，等于没关。
NLC_SKILL_MYTHOS_BASE_URL=

# ── Skill metadata 新增 ─────────────────────────────────────────────────────────────
# Agent 元信息：skill 脚本可通过 os.getenv("element_name", "") 获取。
element_name=On‑Prem CoWork
agent_display_name=CoWork


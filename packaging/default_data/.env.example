# ── HITL (human-in-the-loop) ──────────────────────────────────────────────────
# 等待人工响应的超时(秒)；留空 = 不超时（无限等待）。
# NLC_HITL_TIMEOUT_SEC=
# 内存中保留的已解决 HITL 请求上限。Default: 1000
# NLC_HITL_MAX_RESOLVED=1000

# ── Task execution ────────────────────────────────────────────────────────────
# Max retry attempts per task before marking it as permanently failed.
# Default: 3  (set to 0 to disable retries)
NLC_TASK_MAX_RETRIES=3

# Max number of tasks running concurrently within a session.
# Default: 1 (serial). Set >1 to allow parallel tasks/sub-agents.
NLC_TASK_MAX_CONCURRENT=1

# 单任务默认 token 预算 / 默认任务超时(毫秒)。
NLC_DEFAULT_TOKEN_BUDGET=0
# NLC_DEFAULT_TASK_TIMEOUT_MS=60000

# File watcher poll interval in seconds (hot reload for templates and skills).
# Default: 5
NLC_WATCH_INTERVAL=5

# ── Logging ───────────────────────────────────────────────────────────────────
# Root log level: DEBUG / INFO / WARNING / ERROR. Default: INFO
# NLC_LOG_LEVEL=INFO
# Output format: "text" or "json". Default: text
# NLC_LOG_FORMAT=text
# Verbosity for the ctx_weft.* engine tree only (default: same as NLC_LOG_LEVEL).
# NLC_CORE_LOG_LEVEL=DEBUG
#
# Also write logs to a DIRECTORY (created if missing). Leave unset to log to
# stdout only. The active file is <NLC_LOG_DIR>/<NLC_LOG_FILENAME>, rotated at
# midnight; old files are kept as netlivecowork.log.2026-06-20, etc.
# NLC_LOG_DIR=./data/logs
# Log file name written inside NLC_LOG_DIR. Default: netlivecowork.log
# NLC_LOG_FILENAME=netlivecowork.log
# Number of rotated daily backups to keep. Default: 7
# NLC_LOG_BACKUP_DAYS=7

# ── Public web fetching ─────────────────────────────────────────
# Read-only static public-page fetching.
NLC_WEB_ENABLED=true

# ── W3 认证 ────────────────────────────────────────────────────────────────
# W3 / UniPortal OAuth2 配置（厂商内置，每次安装/升级强制对齐随包模板）
W3_BASE_URL=https://uniportal.huawei.com
W3_CLIENT_ID=com.huawei.ipmastercowork
W3_CLIENT_SECRET=com.huawei.ipmastercowork
W3_CALLBACK_URL=https://ipmastercowork.gts.huawei.com/callBack
W3_SCOPE=base.profile
# CoWork Cloud Backend 地址（供 Python /w3/auth 转发白名单校验）
COWORK_CLOUD_BASE_URL=https://ipmastercowork.gts.huawei.com

    "docx-preview": "^0.3.7",
    "driver.js": "^1.3.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",

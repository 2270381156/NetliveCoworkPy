# ctx-weft Configuration Example
# Copy to .env and fill in values. System environment variables take precedence.

# ── LLM 默认账号 ──────────────────────────────────────────────────────────────
# 默认账号不再用 IPMC_LLM_* 环境变量，改由扁平 JSON 种子提供（可多账号、多 provider）：
#   出厂/随包模板：packaging/default_data/default_llm_accounts.json
#   字段：account / style / api_key(明文或 enc:v1: 密文) / base_url / model /
#         context_limit / output_reserve / output_ceiling / timeout_sec
#   混淆密钥：python -m netlivecowork.providers.llm.secret encrypt "sk-..."
# 本地开发覆盖：设下面这行指向一个 gitignored 本地文件（放真实 key，不入库），不设则用随包模板。
# 有问题即报错（fail-fast），不再有 env 兜底。
# IPMC_LLM_ACCOUNTS_FILE=data/llm_accounts.dev.json

# ── Persistence ───────────────────────────────────────────────────────────────
# Memory provider backend. Omit for in-memory (stateless, default).
#
# SQLite (local dev — file created at project root):
# DATABASE_URL=sqlite
# SQLite with explicit path:
# DATABASE_URL=sqlite:///./data/ipmc.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/CtxWeft
DATABASE_URL=sqlite

# ── Resources ────────────────────────────────────────────────────────────────
# Root directory for all user-authored and runtime config files.
# Defaults to <project_root>/resources/ when not set.
#
# Default layout under IPMC_RESOURCES_DIR:
#   agents/           agent template directories      (IPMC_AGENTS_DIR default)
#   skills/           local skill directories         (IPMC_SKILLS_DIR default)
#   templates/        template metadata JSON          (TemplateStore)
#   llm_configs/      LLM account configs JSON        (LLMAccountStore)
#   skill_sources/    remote skill source configs     (RemoteSkillSourceStore)
#   skill_caches/     git-synced remote skill files   (RemoteSkillCapabilityProvider)
#   mcp.json          MCP server configs              (MCPServerStore)
IPMC_RESOURCES_DIR=

# Override individual subdirs (optional — defaults to subdirs of IPMC_RESOURCES_DIR):
IPMC_AGENTS_DIR=
IPMC_SKILLS_DIR=

# ── Data ──────────────────────────────────────────────────────────────────────
# Directory for persistent database files only (SQLite / Postgres data).
# Defaults to <project_root>/data/ when not set.
# SQLite file: <IPMC_DATA_DIR>/ipmc-dev.db (or set DATABASE_URL explicitly).
IPMC_DATA_DIR=

# ── Filesystem tools (bash auto-venv) ─────────────────────────────────────────
# Interpreter used to create the per-workspace Python .venv when an agent runs a
# python/pip command. Leave empty to use the host's own interpreter
# (sys.executable) — correct for dev/source runs. In the packaged desktop app the
# frozen sys.executable is the app exe and cannot run `-m venv`, so _run.py auto-
# points this at the bundled runtime (exe_dir/python-runtime/python.exe). Only set
# it manually to force a specific Python.
# IPMC_FS_BASH_VENV_PYTHON=

# Internal PyPI mirror for `pip install` (used by both bash_exec and skill scripts,
# which run pip in the workspace venv). Mapped to the standard PIP_* env vars at
# startup, so all subprocesses inherit them. For an http (non-https) mirror, also set
# the trusted host to avoid pip's TLS error.
# IPMC_PIP_INDEX_URL=http://10.25.x.x:port/simple
# IPMC_PIP_EXTRA_INDEX_URL=
# IPMC_PIP_TRUSTED_HOST=10.25.x.x

# ── Task execution ────────────────────────────────────────────────────────────
# Max retry attempts per task before marking it as permanently failed.
# Default: 3  (set to 0 to disable retries)
IPMC_TASK_MAX_RETRIES=3

# Max number of tasks running concurrently within a session.
# Default: 1 (serial). Set >1 to allow parallel tasks/sub-agents.
IPMC_TASK_MAX_CONCURRENT=1

# File watcher poll interval in seconds (hot reload for templates and skills).
# Default: 5
IPMC_WATCH_INTERVAL=5

# ── Logging ───────────────────────────────────────────────────────────────────
# Root log level: DEBUG / INFO / WARNING / ERROR. Default: INFO
# IPMC_LOG_LEVEL=INFO
# Output format: "text" or "json". Default: text
# IPMC_LOG_FORMAT=text
# Verbosity for the ctx_weft.* engine tree only (default: same as IPMC_LOG_LEVEL).
# IPMC_CORE_LOG_LEVEL=DEBUG
#
# Also write logs to a DIRECTORY (created if missing). Leave unset to log to
# stdout only. The active file is <IPMC_LOG_DIR>/<IPMC_LOG_FILENAME>, rotated at
# midnight; old files are kept as netlivecowork.log.2026-06-20, etc.
# IPMC_LOG_DIR=./data/logs
# Log file name written inside IPMC_LOG_DIR. Default: netlivecowork.log
# IPMC_LOG_FILENAME=netlivecowork.log
# Number of rotated daily backups to keep. Default: 7
# IPMC_LOG_BACKUP_DAYS=7

# ── Public web fetching ─────────────────────────────────────────
# Read-only static public-page fetching.
IPMC_WEB_ENABLED=true

# ── W3 认证 ────────────────────────────────────────────────────────────────
# W3 / UniPortal OAuth2 配置（厂商内置，每次安装/升级强制对齐随包模板）
W3_BASE_URL=https://uniportal.huawei.com
W3_CLIENT_ID=com.huawei.ipmastercowork
W3_CLIENT_SECRET=com.huawei.ipmastercowork
W3_CALLBACK_URL=https://ipmastercowork.gts.huawei.com/callBack
W3_SCOPE=base.profile
# CoWork Cloud Backend 地址（供 Python /w3/auth 转发白名单校验）
COWORK_CLOUD_BASE_URL=https://ipmastercowork.gts.huawei.com